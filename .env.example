# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Every value below comes from Supabase -> Connect -> ORM (Prisma), except the API keys.
#
# If your database password contains # @ / : ? & % or +, percent-encode it inside
# the URL: # becomes %23, & becomes %26. The password itself does not change.

# POOLED connection, port 6543. Used by the running app. Serverless opens a
# connection per invocation; the pooler stops that exhausting Postgres' limit.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# SESSION connection, port 5432. Used by the Prisma CLI for migrations and seeding,
# which take advisory locks and run DDL a transaction pooler cannot carry.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase -> Project Settings -> API. Not needed until step 7 (proof-of-payment uploads).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
# Master key: full access, bypasses every permission. Server only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY="the service_role key"

# Storage bucket for payment-proof screenshots.
SUPABASE_STORAGE_BUCKET="proof-of-payment"

# Shared secret for the daily purge at /api/cron/purge, which destroys anything
# that has sat in Recently Deleted for 30 days. Vercel sends it as a Bearer
# token on scheduled runs; set the same value in the Vercel project settings.
# Any random 32+ characters will do: `openssl rand -base64 32`.
#
# UNSET MEANS NOTHING IS EVER PURGED. The endpoint refuses rather than running
# unauthenticated, so deleted rows simply pile up until this is set.
CRON_SECRET="a long random string"

# OPTIONAL. A SELECT-only Postgres role for reconciliation queries
# (.claude/harness/db-ro.mjs, used by the data-truth agent). Unset, that script
# falls back to DIRECT_URL and relies on its own read-only transaction instead.
DB_RO_URL=""
