# Copy this file to .env and fill in the real values. .env is gitignored — never commit it.

# Supabase → Project Settings → Database → Connection string
#
# DIRECT connection, port 5432. Used by the Prisma CLI for migrations and seeding.
# Migrations take advisory locks and run DDL, which a transaction pooler cannot carry.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# POOLED connection, port 6543, with ?pgbouncer=true. Used by the running app.
# Serverless functions open a connection per invocation; without the pooler a
# busy moment exhausts Postgres' connection limit and the app starts erroring.
DATABASE_POOL_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="the service_role key — server only, never expose to the browser"

# Storage bucket for payment-proof screenshots.
SUPABASE_STORAGE_BUCKET="proof-of-payment"
