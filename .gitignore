
# provenly runtime state (the config at the root is tracked, this is not)
.claude/.harness/

# reconciliation measurements quote REAL borrowers' names, ids and debts straight
# out of the database, and this repo is public. They stay on the machine that made
# them. The agent that writes them (.claude/agents/data-truth.md) is tracked; its
# output is not.
.claude/reconciliation/

# personal settings, not shared
.claude/settings.local.json

# --- Next.js ---

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
